\begin{tikzpicture}[
    font=\footnotesize,
    node distance=0.43cm and 0.72cm,
    terminator/.style={
        draw,
        rounded corners=9pt,
        align=center,
        minimum height=0.62cm,
        inner sep=3pt,
        text width=2.95cm,
        fill=blue!6
    },
    process/.style={
        draw,
        rectangle,
        align=center,
        minimum height=0.62cm,
        inner sep=3pt,
        text width=3.45cm,
        fill=green!7
    },
    warn/.style={
        draw,
        rectangle,
        align=center,
        minimum height=0.62cm,
        inner sep=3pt,
        text width=2.85cm,
        fill=orange!10
    },
    decision/.style={
        draw,
        diamond,
        aspect=2.75,
        align=center,
        inner xsep=1pt,
        inner ysep=0pt,
        text width=2.65cm,
        minimum width=4.10cm,
        minimum height=1.22cm,
        fill=yellow!12
    },
    arrow/.style={-{Latex[length=2mm]}, thick}
]
    \node[terminator] (setup) {Bắt đầu\\\texttt{lp.setup}};
    \node[process, text width=4.75cm, right=0.78cm of setup] (regs) {Cập nhật \texttt{LPSTART}, \texttt{LPEND}\\\texttt{LPCOUNT}, \texttt{LPACTIVE}};
    \node[process, text width=4.75cm, below=of regs] (body) {Thân vòng\\\texttt{LPSTART} \(\ldots\) \texttt{LPEND}};
    \node[decision, below=of body] (tail) {Chạm\\\texttt{LPEND}?};
    \node[decision, below=of tail] (predict) {Front-end\\dự đoán kịp?};
    \node[process, text width=3.45cm, below=0.68cm of predict] (commit) {Commit lệnh cuối\\giảm \texttt{LPCOUNT} và cập nhật BTB};
    \node[warn, left=0.72cm of commit] (backend) {IEW sửa PC\\\texttt{nonControl}\\\texttt{Redirects}};
    \node[process, text width=3.20cm, right=0.72cm of commit] (frontend) {BAC/FTQ\\đưa fetch về \texttt{LPSTART}};
    \node[decision, below=of commit] (check) {Sau commit\\\texttt{LPCOUNT} còn?};
    \node[process, text width=2.80cm, below left=0.54cm and 0.76cm of check] (again) {Giữ mục tiêu\\\texttt{LPSTART}};
    \node[terminator, text width=3.00cm, below right=0.54cm and 0.76cm of check] (done) {Kết thúc vòng\\xóa mục tiêu\\tắt \texttt{LPACTIVE}};

    \draw[arrow] (setup) -- (regs);
    \draw[arrow] (regs) -- (body);
    \draw[arrow] (body) -- (tail);
    \draw[arrow] (tail) -- node[right] {có} (predict);
    \draw[arrow] (tail.west) -- ++(-0.80,0) node[pos=0.15, above] {chưa} |- (body.west);
    \draw[arrow] (predict.south east) -- node[pos=0.28, right] {có} (frontend.north);
    \draw[arrow] (frontend) -- (commit);
    \draw[arrow] (predict.south west) -- node[pos=0.28, left] {không} (backend.north);
    \draw[arrow] (backend) -- (commit);
    \draw[arrow] (commit) -- (check);
    \draw[arrow] (check) -| node[pos=0.28, above] {có} (again.north);
    \draw[arrow] (check) -| node[pos=0.28, above] {không} (done.north);
    \draw[arrow] (again.west) -- ++(-1.10,0) |- (body.west);
\end{tikzpicture}
